# LaStarter : configuration environnement unique
# Copier vers .env et ajuster, ou laisser le CLI générer (lastarter install)

# === DOMAINE ===
LASTARTER_DOMAIN=localhost:8443
LASTARTER_SCHEME=https

# === BASE DE DONNEES KEYCLOAK ===
KC_DB_PASSWORD=change-me-in-production

# === THEME ===
LASTARTER_THEME=element-light
LASTARTER_BRAND_NAME=LaStarter
LASTARTER_BRAND_COLOR=#0bc491
LASTARTER_LOGO_URL=

# === CHIFFREMENT (Synapse / Discussions) ===
SYNAPSE_REGISTRATION_SECRET=change-me
SYNAPSE_MACAROON_SECRET=change-me
SYNAPSE_FORM_SECRET=change-me
