# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Rendus runtime du CLI (secrets substitués, realm, thème, configs natifs)
.runtime/
deployments/*/.runtime/

# Secrets générés par le CLI — à chiffrer (SOPS / ansible-vault) avant tout commit
deployments/*/secrets.env
deployments/*/secrets/

# Données locales de dev (POC compose)
deploy/compose/**/data/
*.local

# OS / éditeurs
.DS_Store
Thumbs.db
node_modules/

# Captures E2E (sorties de scripts)
scripts/e2e/*.png
