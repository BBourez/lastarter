// Renovate — bumps des pins LaStarter.
// Catalogue (upstream_image + upstream_pin) et fichiers compose (image:).
// Chaque PR de bump déclenche la CI (tests + gate licence) puis un smoke
// `lastarter deploy && lastarter smoke` sur l'environnement de recette.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 2,
  "labels": ["bump"],
  "packageRules": [
    {
      "description": "Les pins de prod ne montent qu'en minor (revue manuelle pour les majeures)",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    }
  ],
  "customManagers": [
    {
      "description": "Pins du catalogue : upstream_image + upstream_pin (toml adjacents)",
      "customType": "regex",
      "fileMatch": ["^catalogue/[^/]+\\.toml$"],
      "matchStrings": [
        "upstream_image = \"(?<depName>[^\"]+)\"\\nupstream_pin = \"(?<currentValue>[^\"]+)\""
      ],
      "datasource": "docker",
      "versioningTemplate": "loose"
    }
  ],
  "docker-compose": {
    "fileMatch": ["(^|/)deploy/compose/[^/]+\\.ya?ml$"]
  }
}
