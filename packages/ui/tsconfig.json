{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["vitest/globals"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "paths": {
            "@lastarter/ui": ["./src"],
            "@lastarter/i18n": ["../i18n/src"],
            "@lastarter/api": ["../api/src"],
            "@lastarter/config": ["../config/src"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts", "src/test-setup.ts", "vitest.config.ts"]
}
