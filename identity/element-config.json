{
  "brand": "{{BRAND}}",
  "default_theme": "custom-{{THEME_NAME}}",
  "default_server_config": {
    "m.homeserver": {
      "base_url": "{{MATRIX_ORIGIN}}",
      "server_name": "{{SERVER_NAME}}"
    }
  },
  "disable_custom_urls": true,
  "disable_guests": true,
  "disable_3pid_login": true,
  "disable_login_language_selector": false,
  "sso_redirect_options": {
    "immediate": true,
    "on_welcome_page": true,
    "on_login_page": true
  },
  "setting_defaults": {
    "custom_themes": [{{CUSTOM_THEME}}],
    "UIFeature.registration": false,
    "UIFeature.passwordReset": false
  },
  "element_call": {
    "brand": "{{BRAND}}",
    "use_exclusively": false
  },
  "widget_build_url": "{{CALL_ORIGIN}}/widget",
  "branding": {
    "auth_header_logo_url": "{{CHAT_ORIGIN}}/themes/element/img/logos/element-logo.svg"
  }
}
