{
  "realm": "lastarter",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "lastarter",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "roles": {
    "realm": [
      { "name": "user", "composite": false },
      { "name": "admin", "composite": false }
    ],
    "client": {
      "account": [
        { "name": "manage-account", "composite": false },
        { "name": "view-profile", "composite": false },
        { "name": "manage-account-links", "composite": false },
        { "name": "view-applications", "composite": false },
        { "name": "view-consent", "composite": false },
        { "name": "manage-consent", "composite": false },
        { "name": "view-groups", "composite": false },
        { "name": "delete-account", "composite": false }
      ]
    }
  },
  "defaultRoles": ["user", "offline_access", "uma_authorization"],
  "clientScopes": [
    {
      "name": "account",
      "description": "Scope audience-account : les tokens destines a la console de compte",
      "protocol": "openid-connect",
      "attributes": { "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience-account",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email"],
  "users": [
    {
      "username": "demo",
      "email": "demo@lastarter.local",
      "firstName": "Demo",
      "lastName": "LaStarter",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "{{SECRET:demo_user_password}}", "temporary": false }
      ],
      "realmRoles": ["user"],
      "clientRoles": {
        "account": [
          "manage-account",
          "view-profile",
          "manage-account-links",
          "view-applications",
          "view-consent",
          "manage-consent",
          "view-groups",
          "delete-account"
        ]
      }
    }
  ],
  "clients": {{CLIENTS_JSON}}
}
