{
  "realm": "lastarter",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "roles": {
    "realm": [
      { "name": "user", "composite": false },
      { "name": "admin", "composite": false }
    ]
  },
  "defaultRoles": ["user", "offline_access", "uma_authorization"],
  "users": [
    {
      "username": "demo",
      "email": "demo@lastarter.local",
      "firstName": "Demo",
      "lastName": "LaStarter",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "{{SECRET:demo_user_password}}", "temporary": false }
      ],
      "realmRoles": ["user"]
    }
  ],
  "clients": {{CLIENTS_JSON}}
}
