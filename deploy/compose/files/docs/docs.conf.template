# LaStarter — conf nginx interne du frontend Docs.
# Montée dans /etc/nginx/templates/docs.conf.template (ro) par deploy/compose/
# docs.yml : l'entrypoint officiel nginx fait l'envsubst des placeholders
# ${BACKEND_HOST}, ${FRONTEND_HOST}, ${YHUB_HOST}, ${S3_HOST}, ${BUCKET_NAME}
# (définis dans docs.yml environment) au démarrage du conteneur.
# Adapté de docker/files/production/etc/nginx/conf.d/default.conf.template
# (amont suitenumerique/docs) : S3 média en http interne (docs-rustfs — alias
# sans tiret bas) et resolver docker dynamique (une cible recréée ne laisse
# pas le proxy sur une IP périmée).

upstream docs_static {
    server ${FRONTEND_HOST}:3000 fail_timeout=0;
}

server {
    listen 8083;
    server_name localhost;
    charset utf-8;

    # increase max upload size
    client_max_body_size 10m;

    # Disables server version feedback on pages and in headers
    server_tokens off;

    location @proxy_to_docs_backend {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $docs_backend_up ${BACKEND_HOST}:8000;
        proxy_pass http://$docs_backend_up;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    location @proxy_to_docs_static {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
        proxy_pass http://docs_static;
    }

    location / {
        try_files $uri @proxy_to_docs_static;
    }

    location /api {
        try_files $uri @proxy_to_docs_backend;
    }

    location /admin {
        try_files $uri @proxy_to_docs_backend;
    }

    location /external_api {
        try_files $uri @proxy_to_docs_backend;
    }

    location /static {
        try_files $uri @proxy_to_docs_backend;
    }

    # Collaboration server. Only the routes below are published: it also serves
    # create-ydoc, reset-connections, migrate, restore-ydoc and reset-ydoc,
    # which the backend calls in-cluster and which must not be reachable from
    # the outside.
    location /collaboration/ws/ {
        # Ensure WebSocket upgrade
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $docs_yhub_up ${YHUB_HOST}:3002;
        proxy_pass http://$docs_yhub_up;

        # Set appropriate timeout for WebSocket
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;

        # Preserve original host and additional headers
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin $http_origin;
        proxy_set_header Host $host;
    }

    # Document routes, guarded by the same document authorization as the
    # websocket, and the public keys the collaboration server signs with.
    location ~ ^/collaboration/(ydoc|rollback|prune|changeset|activity|jwks)/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $docs_yhub_up ${YHUB_HOST}:3002;
        proxy_pass http://$docs_yhub_up;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin $http_origin;
        proxy_set_header Host $host;
    }

    # Proxy auth for media — S3 interne en http (rustfs) : le backend signe
    # (media-auth) puis le frontend sert l'objet depuis docs-rustfs.
    location /media/ {
        # Auth request configuration
        auth_request /media-auth;
        auth_request_set $authHeader $upstream_http_authorization;
        auth_request_set $authDate $upstream_http_x_amz_date;
        auth_request_set $authContentSha256 $upstream_http_x_amz_content_sha256;

        # Pass specific headers from the auth response
        proxy_set_header Authorization $authHeader;
        proxy_set_header X-Amz-Date $authDate;
        proxy_set_header X-Amz-Content-SHA256 $authContentSha256;

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $docs_s3_up ${S3_HOST};
        # /media/<objet> -> /<bucket>/<objet> (rewrite : le proxy_pass variable
        # sans URI transmet l'URI réécrite).
        rewrite ^/media/(.*)$ /${BUCKET_NAME}/$1 break;
        proxy_pass http://$docs_s3_up;
        proxy_set_header Host ${S3_HOST};

        add_header Content-Security-Policy "default-src 'none'" always;
    }

    location /media-auth {
        internal;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $docs_backend_up ${BACKEND_HOST}:8000;
        proxy_pass http://$docs_backend_up/api/v1.0/documents/media-auth/;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Original-URL $request_uri;

        # Prevent the body from being passed
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-Method $request_method;
    }
}
