# lastarter — brouillon d'environnement pour la brique « drive ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

FRONTEND_THEME=dsfr-light
DJANGO_EMAIL_BRAND_NAME=LaStarter
DJANGO_EMAIL_LOGO_IMG={origin}/assets/logo.png
DJANGO_EMAIL_URL_APP={origin}
FRONTEND_HELP_MENU_CONFIG={}
FRONTEND_FEEDBACK_BUTTON_SHOW=False
DJANGO_CONFIGURATION={django_configuration}
ALLOWED_HOSTS={app_bare}
DJANGO_ALLOWED_HOSTS={app_bare}
DJANGO_CSRF_TRUSTED_ORIGINS={origin}
DJANGO_SECRET_KEY={secret:django_secret_key}
DJANGO_SETTINGS_MODULE=drive.settings
DJANGO_SUPERUSER_PASSWORD={secret:django_superuser_password}
USER_RECONCILIATION_FORM_URL={origin}
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO
DB_HOST=drive_postgresql
DB_NAME=drive
DB_USER=drive
DB_PASSWORD={secret:drive_db_password}
DB_PORT=5432
POSTGRES_DB=drive
POSTGRES_USER=drive
POSTGRES_PASSWORD={secret:drive_db_password}
REDIS_URL=redis://drive_redis:6379/0
DJANGO_CELERY_BROKER_URL=redis://drive_redis:6379/0
AWS_S3_ENDPOINT_URL=http://drive_rustfs:9000
AWS_S3_ACCESS_KEY_ID=drive
AWS_S3_SECRET_ACCESS_KEY={secret:s3_secret_key}
AWS_S3_REGION_NAME=eu-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_DOMAIN_REPLACE=https://{domain_s3}
AWS_STORAGE_BUCKET_NAME=drive-media-storage
MEDIA_BASE_URL={origin}
RUSTFS_ACCESS_KEY=drive
RUSTFS_SECRET_KEY={secret:s3_secret_key}
RUSTFS_CORS_ALLOWED_ORIGINS={origin}
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=drive
OIDC_RP_CLIENT_SECRET={secret:oidc_client_secret}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email
OIDC_USER_FIELD_TO_SHORTNAME=given_name
OIDC_USER_FIELDS_TO_FULLNAME=given_name,usual_name
LOGIN_REDIRECT_URL={origin}
LOGIN_REDIRECT_URL_FAILURE={origin}
LOGOUT_REDIRECT_URL={origin}
WOPI_CLIENTS=
