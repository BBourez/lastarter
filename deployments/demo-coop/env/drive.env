# lastarter — brouillon d'environnement pour la brique « drive ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

BRAND_NAME=LaStarter
DRIVE_BACKEND_IMAGE=lastarter/drive-backend:latest
DRIVE_FRONTEND_IMAGE=lastarter/drive:compound
OIDC_RP_CLIENT_ID=drive
OIDC_RP_CLIENT_SECRET={secret:drive_oidc_secret}
