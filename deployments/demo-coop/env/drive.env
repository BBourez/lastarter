# lastarter — brouillon d'environnement pour la brique « drive ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

FRONTEND_THEME=dsfr-light
DJANGO_EMAIL_BRAND_NAME=LaStarter
DJANGO_EMAIL_LOGO_IMG=https://demo.coop.example.com/assets/logo.png
DJANGO_EMAIL_URL_APP=https://demo.coop.example.com
FRONTEND_HELP_MENU_CONFIG={}
FRONTEND_FEEDBACK_BUTTON_SHOW=False
DJANGO_ALLOWED_HOSTS=demo.coop.example.com
DJANGO_SECRET_KEY={secret:django_secret_key}
DJANGO_SETTINGS_MODULE=drive.settings
AWS_S3_ACCESS_KEY_ID=drive
AWS_S3_SECRET_ACCESS_KEY={secret:s3_secret_key}
AWS_S3_REGION_NAME=eu-east-1
AWS_S3_ENDPOINT_URL=http://rustfs:9000
AWS_S3_DOMAIN_REPLACE=https://demo.coop.example.com
OIDC_OP_AUTHORIZATION_ENDPOINT=https://demo.coop.example.com/realms/lastarter/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://demo.coop.example.com/realms/lastarter/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://demo.coop.example.com/realms/lastarter/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/certs
OIDC_RP_CLIENT_ID=drive
OIDC_RP_CLIENT_SECRET={secret:oidc_client_secret}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email
LOGIN_REDIRECT_URL=https://demo.coop.example.com
LOGOUT_REDIRECT_URL=https://demo.coop.example.com
WOPI_CLIENTS=collabora
