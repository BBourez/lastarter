# lastarter — brouillon d'environnement pour la brique « synapse ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD={secret:synapse_db_password}
OIDC_RP_CLIENT_ID=synapse
OIDC_RP_CLIENT_SECRET={secret:synapse_oidc_secret}
