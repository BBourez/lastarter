# lastarter — brouillon d'environnement pour la brique « docs ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

DOCS_BACKEND_IMAGE=lasuite/impress-backend:v6.0.3
DOCS_FRONTEND_IMAGE=lasuite/impress-frontend:v6.0.3
DOCS_YHUB_IMAGE=lasuite/impress-yhub:v6.0.3
DOCS_YPROVIDER_IMAGE=lasuite/impress-y-provider:v6.0.3
DOCS_ORIGIN={origin}
DOCS_DB_PASSWORD={secret:docs_db_password}
DOCS_S3_SECRET_KEY={secret:docs_s3_secret}
DJANGO_SETTINGS_MODULE=impress.settings
DJANGO_CONFIGURATION={django_configuration}
DJANGO_SECRET_KEY={secret:docs_django_secret_key}
DJANGO_ALLOWED_HOSTS={app_bare}
PYTHONPATH=/app
DB_HOST=docs_postgresql
DB_NAME=docs
DB_USER=docs
DB_PASSWORD={secret:docs_db_password}
DB_PORT=5432
REDIS_URL=redis://docs_redis:6379/1
DJANGO_CELERY_BROKER_URL=redis://docs_redis:6379/0
JWT_PRIVATE_KEY_FILE=/keys/private.pem
YHUB_API_BASE_URL=http://docs_yhub:3002
Y_PROVIDER_API_BASE_URL=http://docs_yprovider:4444/api/
Y_PROVIDER_API_KEY={secret:docs_yprovider_api_key}
PORT=3002
REDIS=redis://docs_yhub_valkey:6379
REDIS_PREFIX=yhub
POSTGRES=postgres://docs:{secret:docs_db_password}@docs_postgresql:5432/yhub
YHUB_JWT_PRIVATE_KEY_FILE=/keys/yhub-private.pem
AWS_S3_ENDPOINT_URL=http://docs-rustfs:9000
AWS_S3_ACCESS_KEY_ID=docs
AWS_S3_SECRET_ACCESS_KEY={secret:docs_s3_secret}
AWS_S3_REGION_NAME=eu-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=docs-media-storage
MEDIA_BASE_URL={origin}
OIDC_OP_JWKS_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=docs
OIDC_RP_CLIENT_SECRET={secret:docs_oidc_secret}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email
LOGIN_REDIRECT_URL={origin}
LOGIN_REDIRECT_URL_FAILURE={origin}
LOGOUT_REDIRECT_URL={origin}
OIDC_REDIRECT_ALLOWED_HOSTS=["https://{app_host}"]
COLLABORATION_WS_URL={ws}://{app_host}/collaboration/ws/v1/docs
COLLABORATION_SERVER_ORIGIN={origin}
COLLABORATION_BACKEND_BASE_URL={origin}
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BRAND_NAME=LaStarter
DJANGO_EMAIL_LOGO_IMG=https://localhost:8443/__lastarter/branding/logo.svg
DJANGO_EMAIL_URL_APP={origin}
FRONTEND_CSS_URL=https://localhost:8443/__lastarter/theme.css
