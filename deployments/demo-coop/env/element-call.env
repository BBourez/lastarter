# lastarter — brouillon d'environnement pour la brique « element-call ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

BRAND_NAME=LaStarter
LIVEKIT_KEY=devkey
LIVEKIT_SECRET=secret
LIVEKIT_AS_TOKEN={secret:lk_as_token}
LIVEKIT_HS_TOKEN={secret:lk_hs_token}
LIVEKIT_JWT_BIND=0.0.0.0:6080
LIVEKIT_URL={ws}://livekit.localhost:8443
LIVEKIT_HS_SERVER_NAME={domain_host}
LIVEKIT_CS_API_URL_OVERRIDES={domain_host}=http://discussions_synapse:8008
LIVEKIT_FULL_ACCESS_HOMESERVERS=*
ELEMENT_CALL_IMAGE=lastarter/element-call:sso
LK_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:0.9.0
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.9
OIDC_RP_CLIENT_SECRET={secret:meet_oidc_secret}
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.9.0
OAUTH2_PROXY_COOKIE_SECRET={secret:meet_gate_cookie_secret}
