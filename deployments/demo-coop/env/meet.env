# lastarter — brouillon d'environnement pour la brique « meet ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

BRAND_NAME=LaStarter
MEET_BACKEND_IMAGE=lasuite/meet-backend:v1.36.2
MEET_FRONTEND_IMAGE=lasuite/meet-frontend:v1.36.2
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6
MEET_ORIGIN={origin}
MEET_DB_PASSWORD={secret:meet_db_password}
MEET_S3_SECRET_KEY={secret:meet_s3_secret}
DJANGO_SETTINGS_MODULE=meet.settings
DJANGO_CONFIGURATION={django_configuration}
DJANGO_SECRET_KEY={secret:meet_django_secret_key}
DJANGO_ALLOWED_HOSTS={app_bare}
PYTHONPATH=/app
MEET_BASE_URL={origin}
DB_HOST=meet_postgresql
DB_NAME=meet
DB_USER=meet
DB_PASSWORD={secret:meet_db_password}
DB_PORT=5432
REDIS_URL=redis://meet_redis:6379/1
CELERY_BROKER_URL=redis://meet_redis:6379/0
OIDC_OP_JWKS_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=meet
OIDC_RP_CLIENT_SECRET={secret:meet_oidc_secret}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile
LOGIN_REDIRECT_URL={origin}
LOGIN_REDIRECT_URL_FAILURE={origin}
LOGOUT_REDIRECT_URL={origin}
OIDC_REDIRECT_ALLOWED_HOSTS=["https://{app_host}"]
ALLOW_LOGOUT_GET_METHOD=True
LIVEKIT_API_KEY=meet
LIVEKIT_API_SECRET={secret:meet_livekit_secret}
LIVEKIT_API_URL=https://livekit.localhost:8443
ALLOW_UNREGISTERED_ROOMS=False
AWS_S3_ENDPOINT_URL=http://meet-rustfs:9000
AWS_S3_ACCESS_KEY_ID=meet
AWS_S3_SECRET_ACCESS_KEY={secret:meet_s3_secret}
AWS_S3_REGION_NAME=eu-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=meet-media-storage
MEDIA_BASE_URL={origin}
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BRAND_NAME=LaStarter
FRONTEND_CUSTOM_CSS_URL=https://localhost:8443/__lastarter/theme.css
