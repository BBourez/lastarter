# lastarter — brouillon d'environnement pour la brique « projects ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

PROJECTS_IMAGE=lasuite/projects:1.27.12
PROJECTS_DB_PASSWORD={secret:projects_db_password}
BASE_URL={origin}
DATABASE_URL=postgresql://projects:{secret:projects_db_password}@projects_postgresql:5432/projects
SECRET_KEY={secret:projects_secret_key}
OIDC_ISSUER={sso_origin}/realms/lastarter
OIDC_CLIENT_ID=projects
OIDC_CLIENT_SECRET={secret:projects_oidc_secret}
OIDC_RP_CLIENT_SECRET={secret:projects_oidc_secret}
OIDC_ENFORCED=true
OIDC_SCOPES=openid email profile
OIDC_USE_DEFAULT_RESPONSE_MODE=true
OIDC_FULLNAME_ATTRIBUTES=name
OIDC_IGNORE_USERNAME=true
OIDC_IGNORE_ROLES=true
ALLOW_ALL_TO_CREATE_PROJECTS=true
TRUST_PROXY=1
