# lastarter — brouillon d'environnement pour la brique « messages ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

DJANGO_EMAIL_BRAND_NAME=LaStarter
DJANGO_EMAIL_LOGO_IMG={origin}/assets/logo.png
DJANGO_CONFIGURATION={django_configuration}
DJANGO_ALLOWED_HOSTS={app_bare}
ALLOWED_HOSTS={app_bare}
DJANGO_SECRET_KEY={secret:messages_django_secret_key}
DJANGO_SETTINGS_MODULE=messages.settings
DJANGO_SUPERUSER_PASSWORD={secret:messages_superuser_password}
DJANGO_CSRF_TRUSTED_ORIGINS={origin}
DB_HOST=messages_postgresql
DB_NAME=messages
DB_USER=messages
DB_PASSWORD={secret:messages_db_password}
DB_PORT=5432
POSTGRES_DB=messages
POSTGRES_USER=messages
POSTGRES_PASSWORD={secret:messages_db_password}
REDIS_URL=redis://messages_redis:6379/0
CELERY_BROKER_URL=redis://messages_redis:6379/0
OPENSEARCH_URL=http://messages_opensearch:9200
AWS_S3_ENDPOINT_URL=http://messages_rustfs:9000
AWS_S3_ACCESS_KEY_ID=st-messages
AWS_S3_SECRET_ACCESS_KEY={secret:messages_s3_secret_key}
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_DOMAIN_REPLACE=https://{domain_s3}
AWS_STORAGE_BUCKET_NAME=msg-imports
STORAGE_MESSAGE_IMPORTS_ENDPOINT_URL=http://messages_rustfs:9000
STORAGE_MESSAGE_IMPORTS_BUCKET_NAME=msg-imports
STORAGE_MESSAGE_IMPORTS_ACCESS_KEY=st-messages
STORAGE_MESSAGE_IMPORTS_SECRET_KEY={secret:messages_s3_secret_key}
RUSTFS_ACCESS_KEY=st-messages
RUSTFS_SECRET_KEY={secret:messages_s3_secret_key}
RUSTFS_CORS_ALLOWED_ORIGINS={origin}
DJANGO_EMAIL_HOST=messages_maildev
DJANGO_EMAIL_PORT=1025
MTA_OUT_RELAY_HOST=messages_maildev:1025
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/lastarter/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=messages
OIDC_RP_CLIENT_SECRET={secret:messages_oidc_client_secret}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email
LOGIN_REDIRECT_URL={origin}
LOGIN_REDIRECT_URL_FAILURE={origin}
LOGOUT_REDIRECT_URL={origin}
