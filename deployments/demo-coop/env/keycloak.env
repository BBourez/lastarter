# lastarter — brouillon d'environnement pour la brique « keycloak ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

KC_THEME=lastarter
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD={secret:kc_admin_password}
KC_DB=postgres
KC_DB_URL_HOST=kc_postgresql
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD={secret:kc_db_password}
KC_DB_SCHEMA=public
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD={secret:kc_db_password}
KC_HOSTNAME={origin}
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
