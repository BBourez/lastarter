# lastarter — brouillon d'environnement pour la brique « calendars ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

CALENDARS_BACKEND_IMAGE=ghcr.io/suitenumerique/calendars-backend:0.1.0
CALENDARS_FRONTEND_IMAGE=ghcr.io/suitenumerique/calendars-frontend:0.1.0
CALENDARS_CALDAV_IMAGE=ghcr.io/suitenumerique/calendars-caldav:0.1.0
CALENDARS_DB_PASSWORD={secret:calendars_db_password}
DJANGO_CONFIGURATION=Production
DJANGO_SETTINGS_MODULE=calendars.settings
DJANGO_SECRET_KEY={secret:calendars_django_secret}
DJANGO_ALLOWED_HOSTS={app_bare}
DJANGO_CSRF_TRUSTED_ORIGINS=https://{app_host}
DB_HOST=calendars_postgresql
DB_NAME=calendars
DB_USER=dinum
DB_PASSWORD={secret:calendars_db_password}
DB_PORT=5432
REDIS_URL=redis://calendars_redis:6379/0
DRAMATIQ_BROKER_URL=redis://calendars_redis:6379/0
DRAMATIQ_RESULT_BACKEND_URL=redis://calendars_redis:6379/1
OIDC_RP_CLIENT_ID=calendars
OIDC_RP_CLIENT_SECRET={secret:calendars_oidc_secret}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email
OIDC_OP_JWKS_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT={sso_origin}/realms/lastarter/protocol/openid-connect/logout
LOGIN_REDIRECT_URL={origin}
LOGIN_REDIRECT_URL_FAILURE={origin}
LOGOUT_REDIRECT_URL={origin}
OIDC_REDIRECT_ALLOWED_HOSTS=["https://{app_host}"]
CALDAV_URL=http://calendars_caldav
CALDAV_OUTBOUND_API_KEY={secret:calendars_caldav_key_out}
CALDAV_INBOUND_API_KEY={secret:calendars_caldav_key_in}
CALDAV_INTERNAL_API_KEY={secret:calendars_caldav_key_internal}
CALDAV_CALLBACK_BASE_URL=http://calendars_backend:8000
PGHOST=calendars_postgresql
PGPORT=5432
PGDATABASE=calendars
PGUSER=dinum
PGPASSWORD={secret:calendars_db_password}
CALDAV_DB_SCHEMA=sabre
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
