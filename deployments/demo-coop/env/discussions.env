# lastarter — brouillon d'environnement pour la brique « discussions ».
# Généré par `lastarter init` — à ajuster puis versionner.
# Les jetons {secret:…} sont substitués au déploiement depuis secrets.env
# (jamais committé en clair).

BRAND_NAME=LaStarter
OIDC_RP_CLIENT_SECRET={secret:discussions_oidc_secret}
SYNAPSE_SERVER_NAME={domain_bare}
SYNAPSE_PUBLIC_BASEURL={origin}/
SYNAPSE_MACAROON_SECRET={secret:discussions_macaroon_secret}
SYNAPSE_FORM_SECRET={secret:discussions_form_secret}
SYNAPSE_SIGNING_KEY={secret:discussions_signing_key}
SYNAPSE_OIDC_ISSUER={sso_origin}/realms/lastarter
ELEMENT_WEB_IMAGE=ghcr.io/element-hq/element-web:v1.12.32
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.163.1
